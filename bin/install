#!/usr/bin/env bash

set -euo pipefail

[ -z "${ASDF_INSTALL_TYPE+x}" ] && echo "ASDF_INSTALL_TYPE is required" && exit 1
[ -z "${ASDF_INSTALL_VERSION+x}" ] && echo "ASDF_INSTALL_VERSION is required" && exit 1
[ -z "${ASDF_INSTALL_PATH+x}" ] && echo "ASDF_INSTALL_PATH is required" && exit 1

install() {
  local install_type=$1
  [ "$install_type" != "version" ] && echo "install type, $install_type, is not supported" && exit 1

  local version=$2
  local install_path=$3
  local bin_install_path="$install_path/bin"
  local bin_path="${bin_install_path}/helmfile"

  local platform
  case "$(uname)" in
    Linux) platform="linux" ;;
    Darwin) platform="darwin" ;;
    *)
      echo "Unsupported operating system: $(uname)" >&2
      return 1
      ;;
  esac

  local arch
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64 | arm64) arch="arm64" ;;
    i386 | i686) arch="386" ;;
    *)
      echo "Unsupported CPU architecture: $(uname -m)" >&2
      return 1
      ;;
  esac

  mkdir -p "${bin_install_path}"

  # Releases before 0.145.0 used the roboll/helmfile repository and a
  # different asset format.
  local numeric_version="${version%%[-+]*}"
  local major minor patch
  IFS=. read -r major minor patch <<< "$numeric_version"
  if [[ ! "$major" =~ ^[0-9]+$ || ! "$minor" =~ ^[0-9]+$ || ! "$patch" =~ ^[0-9]+$ ]]; then
    echo "Unsupported Helmfile version: ${version}" >&2
    return 1
  fi

  if ((major > 0 || minor >= 145)); then
      local download_url="https://github.com/helmfile/helmfile/releases/download/v${version}/helmfile_${version}_${platform}_${arch}.tar.gz"
      local archive_path
      archive_path=$(mktemp "${TMPDIR:-/tmp}/asdf-helmfile.XXXXXX")
      echo "Downloading helmfile from ${download_url}"
      if ! curl -fsSL "$download_url" -o "$archive_path"; then
        rm -f "$archive_path"
        return 1
      fi
      if ! tar -C "$bin_install_path" -xf "$archive_path" helmfile; then
        rm -f "$archive_path"
        return 1
      fi
      rm -f "$archive_path"
  else
      local download_url="https://github.com/roboll/helmfile/releases/download/v${version}/helmfile_${platform}_${arch}"
      echo "Downloading helmfile from ${download_url}"
      curl -fsSL "$download_url" -o "$bin_path"
      chmod +x "$bin_path"
  fi
}

install "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"
